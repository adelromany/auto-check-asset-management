AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
REDIRECT_URI=http://localhost:8080/auth/callback
# Required when SSO_ENABLED=true. Generate a long random value; the app
# refuses to start with an empty value or the placeholder "change-me".
SESSION_SECRET=
HTTPS_ONLY=false
SSO_ENABLED=false
DEV_USER_NAME=Dev
DEV_USER_EMAIL=Dev@Blabs.com
# Show the read-only clipboard diagnostics page (local troubleshooting only)
ENABLE_DIAG=false
# Handover portal persistence (PostgreSQL in production, SQLite for dev/tests)
DATABASE_URL=sqlite+aiosqlite:///./data/handover.db
DOCUMENTS_DIR=./data/documents
DOCUMENT_MAX_BYTES=10485760
SNIPEIT_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO
# In-memory rate limits (single process): requests per window, window seconds.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_SUBMIT_PER_WINDOW=60
RATE_LIMIT_RECIPIENT_SEARCH_PER_WINDOW=60

# Copy this file to .env and replace every CHANGE_ME value.
# .env is git-ignored; this example contains placeholders only.

# Port the Snipe-IT UI/API is published on (http://localhost:8080).
SNIPEIT_PORT=8080
SNIPEIT_APP_URL=http://localhost:8080

# Laravel application key. Generate a fresh one, e.g.:
#   python -c "import base64,os;print('base64:'+base64.b64encode(os.urandom(32)).decode())"
SNIPEIT_APP_KEY=base64:CHANGE_ME_GENERATE_A_NEW_KEY

# MariaDB credentials for the development database.
SNIPEIT_DB_DATABASE=snipeit
SNIPEIT_DB_USERNAME=snipeit
SNIPEIT_DB_PASSWORD=CHANGE_ME_DB_PASSWORD
SNIPEIT_DB_ROOT_PASSWORD=CHANGE_ME_DB_ROOT_PASSWORD
